# Generated from scripts/configure.sh.
# Placeholders:
#   __OPAC_SERVER_NAME__
#   __STAFF_SERVER_NAME__
#   __TLS_CERT__
#   __TLS_KEY__
server {
    listen 8443 ssl http2;
    server_name __OPAC_SERVER_NAME__;

    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_session_timeout 1d;
    # Shared cache lets Nginx worker processes reuse TLS sessions from the same named cache.
    ssl_session_cache shared:chengetai_koha_ssl:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location / {
        proxy_pass http://koha:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}

server {
    listen 9443 ssl http2;
    server_name __STAFF_SERVER_NAME__;

    ssl_certificate __TLS_CERT__;
    ssl_certificate_key __TLS_KEY__;
    ssl_session_timeout 1d;
    # Shared cache lets Nginx worker processes reuse TLS sessions from the same named cache.
    ssl_session_cache shared:chengetai_koha_ssl:10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz {
        add_header Content-Type text/plain;
        return 200 'ok';
    }

    location / {
        proxy_pass http://koha:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
