#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<HELP
ChengetAi Koha Engine

Usage:
  chengetai-koha configure
  chengetai-koha install
  chengetai-koha create-instance
  chengetai-koha start
  chengetai-koha stop
  chengetai-koha backup <dir>
  chengetai-koha restore <dir>
  chengetai-koha update
  chengetai-koha uninstall [--purge]
  chengetai-koha healthcheck [--wait]
HELP
}

cmd="${1:-}"
[ "$#" -gt 0 ] && shift || true

case "$cmd" in
    configure|install|create-instance|start|stop|backup|restore|update|uninstall|healthcheck)
        exec bash "$ROOT/scripts/$cmd.sh" "$@"
        ;;
    help|"")
        usage
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
