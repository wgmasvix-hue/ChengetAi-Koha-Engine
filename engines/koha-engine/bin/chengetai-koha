#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

usage() {
    cat <<HELP
ChengetAi Koha Engine

Usage:
  chengetai-koha configure
  chengetai-koha install
  chengetai-koha start
  chengetai-koha stop
  chengetai-koha backup <dir>
  chengetai-koha restore <dir>
  chengetai-koha healthcheck
HELP
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    configure|install|start|stop|healthcheck)
        exec bash "$ROOT/scripts/$cmd.sh" "$@"
        ;;
    backup|restore)
        exec bash "$ROOT/scripts/$cmd.sh" "$@"
        ;;
    help|"")
        usage
        ;;
    *)
        echo "Unknown command: $cmd" >&2
        usage >&2
        exit 1
        ;;
esac
