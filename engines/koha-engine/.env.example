# Replace every *_PASSWORD placeholder before using this file directly.
DEPLOY_NAME=koha
INSTITUTION='ChengetAi Library'
REPOSITORY=koha
ADMIN_EMAIL=admin@example.com
ADMIN_FIRST_NAME=Koha
ADMIN_LAST_NAME=Administrator
TZ=UTC
UI_PORT=4000
REST_PORT=8080
STAFF_PORT=8080
KOHA_DOMAIN=localhost
KOHA_INSTANCE=koha
KOHA_ADMINUSER=admin
KOHA_ADMINPASS=REPLACE_WITH_SECURE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
MYSQL_DATABASE=koha_koha
MYSQL_USER=admin
MYSQL_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
RABBITMQ_USER=koha
RABBITMQ_PASSWORD=REPLACE_WITH_SECURE_PASSWORD
RABBITMQ_STOMP_PORT=61613
MEMCACHED_SERVERS=memcached:11211
ELASTICSEARCH_HOST=opensearch
OPENSEARCH_JAVA_OPTS='-Xms512m -Xmx512m'
KOHA_LANGS=en
TLS_ENABLED=true
TLS_CERT_FILE=config/certs/tls.crt
TLS_KEY_FILE=config/certs/tls.key
COMPOSE_PROJECT_NAME=chengetai-koha
